        "alt": "Close up of data numbers",
        "usage": "Login page background or 'Real-time Data' feature"
      }
    },
    "icons": {
      "library": "lucide-react",
      "style": "Stroke width 1.5px, size 20px or 24px"
    }
  },
  "implementation_guide": {
    "steps": [
      "1. SETUP: Install fonts (Unbounded, Manrope, JetBrains Mono) in index.css",
      "2. THEME: Update tailwind.config.js with the specific neon palette (primary: #00FF94)",
      "3. GLOBAL: Apply dark mode by default in index.html/body (class='dark bg-[#050505]')",
      "4. COMPONENTS: Customize Shadcn components. Remove rounded-md, use rounded-sm. Remove white backgrounds, use #0A0A0A.",
      "5. LAYOUT: Build the Dashboard Shell (Sidebar + Topbar + Main Content Area).",
      "6. PAGES: Implement Landing Page with 'Tetris Grid' and Hero Glow.",
      "7. CHARTS: Implement Recharts with custom dark tooltips and neon lines."
    ],
    "universal_rules": [
      "DO NOT use gradients for text unless it's a very subtle title effect.",
      "DO NOT use rounded-xl or rounded-2xl. Keep it sharp (rounded-sm or rounded-none).",
      "ALWAYS use 'JetBrains Mono' for numbers displayed in the dashboard.",
      "Ensure all interactive elements have hover states (brightness-110 or border color change).",
      "Use 'sonner' for all notifications (success/error alerts)."
    ]
  }
}